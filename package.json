{
  "name": "inventory-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:ensure && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit",
    "arch": "tsx scripts/check-architecture.ts",
    "verify:prepare": "tsx scripts/prepare-verify.ts",
    "verify:test": "DATABASE_URL=file:./prisma/verify.db vitest run",
    "verify": "npm run verify:prepare && npm run typecheck && npm run lint && npm run arch && npm run verify:test && npm run build",
    "db:ensure": "tsx scripts/ensure-db.ts",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:reset": "rm -f prisma/dev.db prisma/dev.db-journal prisma/dev.db-wal prisma/dev.db-shm && npm run db:ensure"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.9",
    "next": "16.3.1",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
